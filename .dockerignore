# Version control
.git
.gitignore

# Local environment / secrets — never baked into the image
.env

# Docker-related files not needed inside the image itself
docker-compose.yml
compose.yaml
.dockerignore

# Persistent-data bind mount target (this is host-side data, not app code)
docker-data/

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Docs not needed at runtime (kept out of the image, still in the repo)
README.md
