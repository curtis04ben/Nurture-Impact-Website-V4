# Nurture Impact — example environment file for Docker Compose.
#
# Copy this file to ".env" (same folder as docker-compose.yml) and fill
# in real values there. ".env" is listed in .gitignore and .dockerignore
# — it is never committed and never baked into the image. Leave any line
# out/blank to use the default shown in docker-compose.yml.

# Port the site is published on, e.g. http://<CASAOS-IP>:8080
NI_HTTP_PORT=8080

# Contact form email transport: "mail" (default, PHP's built-in mail())
# or "smtp" (recommended for reliable delivery outside of Blacknight's
# own mail setup — e.g. when testing in Docker/CasaOS).
NI_MAIL_TRANSPORT=mail

# Only needed when NI_MAIL_TRANSPORT=smtp:
NI_SMTP_HOST=
NI_SMTP_PORT=587
NI_SMTP_ENCRYPTION=tls
NI_SMTP_USERNAME=
NI_SMTP_PASSWORD=
NI_MAIL_FROM_EMAIL=no-reply@nurtureimpact.ie
NI_MAIL_FROM_NAME=Nurture Impact Website
